# Éles beállítások mintája. Másold .env néven a szerverre, és töltsd ki a <...> részeket.
# Titkot (jelszó, token, kulcs) soha ne tegyél gitbe.

APP_NAME=AdReuse
APP_ENV=production
# Csak az első telepítéskor generáld: php artisan key:generate
# Később NE generáld újra, különben minden bejelentkezés és titkosított adat érvénytelen lesz.
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.adreuse.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=<mariadb konténer neve>
DB_PORT=3306
DB_DATABASE=adreuse
DB_USERNAME=adreuse
DB_PASSWORD=<erős jelszó>

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Levélküldés: Cloudflare Email Service (SMTP)
# Token: Cloudflare dashboard → My Profile → API Tokens → Create Token,
# jogosultság: Account → Email Sending → Edit. A felhasználónév szó szerint "api_token".
# Kipróbálás: php artisan app:test-mail sajat@cim.hu
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.mx.cloudflare.net
MAIL_PORT=465
MAIL_USERNAME=api_token
MAIL_PASSWORD=<Cloudflare API token>
MAIL_FROM_ADDRESS=noreply@adglobalapp.com
MAIL_FROM_NAME="AdGlobalApp"

# Kapcsolati űrlapok (POST /api/contact)
CONTACT_MAIL_TO=info@adglobalapp.com
CONTACT_SITES=adlingua,adtransport,admaintenance,adreuse,adlanding
CORS_ALLOWED_ORIGINS=https://adlingua.org,https://adglobaltransport.com,https://admaintenance.services,https://adreuse.uk,https://adglobalapp.com,https://www.adglobalapp.com

# AdReuse backend – éles beállítások mintája (docker: env_file). A titkos értékeket csak a szerveren töltsd ki,
# gitbe, image-be vagy chatbe ne kerüljenek.

APP_NAME=AdReuse
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.adreuse.uk
# Egyszer generáld le, és utána SOHA ne változtasd meg (különben a bejelentkezések és a titkosított adatok elvesznek):
#   docker run --rm --entrypoint php ghcr.io/adglobalapp/adreuse-backend:latest artisan key:generate --show
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Konténerben a naplók a docker logba menjenek
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# MariaDB (a meglévő "mysql" konténer a web hálózaton)
DB_CONNECTION=mariadb
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=adreuse
DB_USERNAME=adreuse
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Levélküldés: Brevo SMTP relay (Brevo → SMTP & API → SMTP: login és SMTP kulcs).
# Kipróbálás: docker exec <konténer> php artisan app:test-mail sajat@cim.hu
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@adglobalapp.com
MAIL_FROM_NAME="AdGlobalApp"

# Kapcsolati űrlapok (POST /api/contact): ide megy az értesítés, a válaszcím a látogatóé
CONTACT_MAIL_TO=info@adglobalapp.com
CONTACT_SITES=adlingua,adtransport,admaintenance,adreuse,adlanding
# Ennyi hónap után az üzenetek automatikusan törlődnek (az adatvédelmi tájékoztatóban is ez szerepel)
CONTACT_RETENTION_MONTHS=24

# Cloudflare Turnstile titkos kulcs (Cloudflare dashboard → Turnstile). Üresen hagyva az ellenőrzés kimarad.
TURNSTILE_SECRET_KEY=

# A böngészők ezekről az oldalakról hívhatják az API-t
CORS_ALLOWED_ORIGINS=https://adlingua.org,https://www.adlingua.org,https://adglobaltransport.com,https://www.adglobaltransport.com,https://admaintenance.services,https://www.admaintenance.services,https://adreuse.uk,https://www.adreuse.uk,https://adglobalapp.com,https://www.adglobalapp.com

# Új fiókok regisztrációja (a frontend VITE_REGISTRATION_ENABLED-jével együtt állítsd)
REGISTRATION_ENABLED=false

# A Laravel API címe élesben (fejlesztéskor üresen hagyva a Vite proxy a localhost:8000-re küld)
VITE_API_URL=
# Új fiókok regisztrációja: 'true' / 'false' (a backend REGISTRATION_ENABLED-jével együtt állítsd)
VITE_REGISTRATION_ENABLED=false
# Cloudflare Turnstile nyilvános site key (a titkos kulcs a backend TURNSTILE_SECRET_KEY-je). Üresen nincs widget.
VITE_TURNSTILE_SITE_KEY=
